              "body": "{\n  \"datasources\": [\n    {\n      \"name\": \"xtreme\",\n      \"type\": \"JDBC (JNDI)\",\n      \"tables\": [\n        \"Customer\",\n        \"Orders\"\n      ]\n    },\n    {\n      \"name\": \"xtreme\",\n      \"type\": \"JDBC (JNDI)\",\n      \"tables\": [\n        \"Customer\",\n        \"Orders\"\n      ]\n    }\n  ],\n  \"usedfields\": [\n    {\n      \"name\": \"Customer Name\",\n      \"table\": \"Customer\",\n      \"type\": \"String\"\n    },\n    {\n      \"name\": \"Customer Name\",\n      \"table\": \"Customer\",\n      \"type\": \"String\"\n    }\n  ],\n  \"groupconditions\": [\n    {\n      \"field\": \"Country\",\n      \"direction\": \"Ascending\"\n    },\n    {\n      \"field\": \"Country\",\n      \"direction\": \"Ascending\"\n    }\n  ],\n  \"parameters\": [\n    {\n      \"name\": \"StartDate\",\n      \"type\": \"Date\",\n      \"prompt\": \"Enter the start date\",\n      \"required\": true,\n      \"default_value\": \"2023-01-01\"\n    },\n    {\n      \"name\": \"StartDate\",\n      \"type\": \"Date\",\n      \"prompt\": \"Enter the start date\",\n      \"required\": true,\n      \"default_value\": \"2023-01-01\"\n    }\n  ],\n  \"summary\": [\n    {\n      \"name\": \"Sum of Order Amount\",\n      \"operation\": \"Sum\",\n      \"field\": \"Order Amount\"\n    },\n    {\n      \"name\": \"Sum of Order Amount\",\n      \"operation\": \"Sum\",\n      \"field\": \"Order Amount\"\n    }\n  ],\n  \"runningtotals\": [\n    {\n      \"name\": \"RunningTotal_OrderAmount\",\n      \"field\": \"Order Amount\",\n      \"operation\": \"Sum\",\n      \"reset_condition\": \"OnGroupChange\"\n    },\n    {\n      \"name\": \"RunningTotal_OrderAmount\",\n      \"field\": \"Order Amount\",\n      \"operation\": \"Sum\",\n      \"reset_condition\": \"OnGroupChange\"\n    }\n  ],\n  \"formulas\": [\n    {\n      \"name\": \"FullAddress\",\n      \"text\": \"{Customer.Address1} & \\\", \\\" & {Customer.City}\"\n    },\n    {\n      \"name\": \"FullAddress\",\n      \"text\": \"{Customer.Address1} & \\\", \\\" & {Customer.City}\"\n    }\n  ],\n  \"subreports\": [\n    {\n      \"name\": \"OrderDetails\",\n      \"uri\": \"/biprws/infostore/5765/rpt/subreport/OrderDetails\"\n    },\n    {\n      \"name\": \"OrderDetails\",\n      \"uri\": \"/biprws/infostore/5765/rpt/subreport/OrderDetails\"\n    }\n  ]\n}",
