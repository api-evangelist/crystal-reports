  "item": [
    {
      "id": "d4c2fb25-2902-4c72-8669-9f138582727e",
      "name": "Export",
      "description": {
        "content": "Report export to various formats",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7873d33f-0e08-4d78-ae30-e593362482d5",
          "name": "Crystal Reports Export Report to Specified Format",
          "request": {
            "name": "Crystal Reports Export Report to Specified Format",
            "description": {
              "content": "Exports a Crystal Report to the specified MIME type format. Supports PDF, CSV, Excel, Word, RTF, TTX, XML, plain text, and modern Excel (XLSX) formats.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "infostore",
                ":reportId",
                "rpt",
                "export"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mime_type",
                  "value": "<string>",
                  "description": "(Required) The MIME type of the desired export format"
                },
                {
                  "disabled": false,
                  "key": "startPageNumber",
                  "value": "<integer>",
                  "description": "Starting page number for the export (PDF only)"
                },
                {
                  "disabled": false,
                  "key": "endPageNumber",
                  "value": "<integer>",
                  "description": "Ending page number for the export (PDF only)"
                },
                {
                  "disabled": false,
                  "key": "isCreateBookmarksFromGroupTree",
                  "value": "<boolean>",
                  "description": "Whether to create bookmarks from the group tree (PDF only)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "reportId",
                  "description": "(Required) Infostore object ID of the Crystal Report"
                },
                {
                  "description": "Hostname of the SAP BusinessObjects server",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "Port number for the RESTful web services",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/PDF"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a52cc84a-a9ca-43d9-986b-c77204078619",
              "name": "Report exported successfully",
              "originalRequest": {
