          "name": "Crystal Reports Get Report Structure and Metadata",
          "request": {
            "name": "Crystal Reports Get Report Structure and Metadata",
            "description": {
              "content": "Returns the full structural metadata of a Crystal Report including datasources, used fields, group conditions, parameters, summary fields, running totals, formulas, and subreports.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "infostore",
                ":reportId",
                "rpt",
                "structure"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "reportId",
                  "description": "(Required) Infostore object ID of the Crystal Report"
                },
                {
                  "description": "Hostname of the SAP BusinessObjects server",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                },
                {
                  "description": "Port number for the RESTful web services",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
